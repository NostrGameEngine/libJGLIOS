diff --git a/src/libANGLE/renderer/metal/DisplayMtl.mm b/src/libANGLE/renderer/metal/DisplayMtl.mm
--- a/src/libANGLE/renderer/metal/DisplayMtl.mm
+++ b/src/libANGLE/renderer/metal/DisplayMtl.mm
@@ -469,3 +469,7 @@
 void DisplayMtl::generateExtensions(egl::DisplayExtensions *outExtensions) const
 {
+    // Float window surfaces are required for Apple EDR; an FP16 offscreen buffer is insufficient.
+    outExtensions->pixelFormatFloat = true;
+    outExtensions->glColorspace = true;
+    outExtensions->glColorspaceScrgbLinear = true;
     outExtensions->iosurfaceClientBuffer      = true;
@@ -635,3 +639,14 @@
+    // Additional single-sample FP16 configurations leave existing SDR choices unchanged.
+    config.renderTargetFormat = GL_RGBA16F;
+    config.colorComponentType = EGL_COLOR_COMPONENT_TYPE_FLOAT_EXT;
+    config.redSize = config.greenSize = config.blueSize = config.alphaSize = 16;
+    config.bufferSize = 64;
+    config.samples = config.sampleBuffers = 0;
+    configs.add(config);
+    config.depthSize = 24;
+    config.stencilSize = 8;
+    config.depthStencilFormat = GL_DEPTH24_STENCIL8;
+    configs.add(config);
     return configs;
 }
 
diff --git a/src/libANGLE/renderer/metal/SurfaceMtl.mm b/src/libANGLE/renderer/metal/SurfaceMtl.mm
--- a/src/libANGLE/renderer/metal/SurfaceMtl.mm
+++ b/src/libANGLE/renderer/metal/SurfaceMtl.mm
@@ -87,3 +87,11 @@
     mColorFormat = display->getPixelFormat(angle::FormatID::B8G8R8A8_UNORM);
+    if (state.config && state.config->colorComponentType == EGL_COLOR_COMPONENT_TYPE_FLOAT_EXT)
+    {
+        mColorFormat = display->getPixelFormat(angle::FormatID::R16G16B16A16_FLOAT);
+    }
+    else if (attribs.get(EGL_GL_COLORSPACE_KHR, EGL_GL_COLORSPACE_LINEAR_KHR) == EGL_GL_COLORSPACE_SRGB_KHR)
+    {
+        mColorFormat = display->getPixelFormat(angle::FormatID::B8G8R8A8_UNORM_SRGB);
+    }
 
     mSamples = state.config->samples;
@@ -463,3 +471,15 @@
         mMetalLayer.get().framebufferOnly = NO;  // Support blitting and glReadPixels
+        if (mColorFormat.metalFormat == MTLPixelFormatRGBA16Float &&
+            mState.attributes.get(EGL_GL_COLORSPACE_KHR, EGL_GL_COLORSPACE_LINEAR_KHR) == EGL_GL_COLORSPACE_SCRGB_LINEAR_EXT)
+        {
+            CGColorSpaceRef colorSpace = CGColorSpaceCreateWithName(kCGColorSpaceExtendedLinearSRGB);
+            mMetalLayer.get().colorspace = colorSpace;
+            CGColorSpaceRelease(colorSpace);
+#if TARGET_OS_OSX || TARGET_OS_MACCATALYST
+            mMetalLayer.get().wantsExtendedDynamicRangeContent = YES;
+#elif TARGET_OS_IOS && !TARGET_OS_TV && !TARGET_OS_WATCH
+            if (@available(iOS 16.0, *)) mMetalLayer.get().wantsExtendedDynamicRangeContent = YES;
+#endif
+        }
 
 #if TARGET_OS_OSX || TARGET_OS_MACCATALYST
